# MonopEli Environment Configuration
# Copy this file to .env and customize as needed.
# All backend settings use the MONOPELI_ prefix.

# =============================================================================
# Server
# =============================================================================
MONOPELI_HOST=0.0.0.0
MONOPELI_PORT=8000
MONOPELI_DEBUG=false
MONOPELI_LOG_LEVEL=INFO

# =============================================================================
# CORS (comma-separated origins)
# =============================================================================
MONOPELI_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# =============================================================================
# Game Settings
# =============================================================================
MONOPELI_MAX_CONCURRENT_GAMES=1000
MONOPELI_MAX_PLAYERS_PER_GAME=8
MONOPELI_GAME_TIMEOUT_MINUTES=180

# =============================================================================
# WebSocket
# =============================================================================
MONOPELI_WS_HEARTBEAT_INTERVAL=30
MONOPELI_WS_RECONNECT_WINDOW=60

# =============================================================================
# AI
# =============================================================================
MONOPELI_AI_THINK_DELAY_MS=500

# Guided Jev is disabled unless explicitly enabled. Keep this key server-side.
MONOPELI_JEV_ENABLED=false
MONOPELI_JEV_MODEL=jev-1.13.0
TYPESAFE_API_KEY=
MONOPELI_JEV_ATTEMPT_TIMEOUT_SECONDS=5
MONOPELI_JEV_CONNECT_TIMEOUT_SECONDS=2
MONOPELI_JEV_MAX_RETRIES=1
MONOPELI_JEV_MAX_CONCURRENT_REQUESTS=2
MONOPELI_JEV_GAME_MAX_REQUESTS=2000
MONOPELI_JEV_GAME_MAX_INPUT_TOKENS=5000000
MONOPELI_JEV_GAME_MAX_COST_USD=0.25
MONOPELI_JEV_PROCESS_MAX_REQUESTS=20000
MONOPELI_JEV_PROCESS_MAX_INPUT_TOKENS=50000000
MONOPELI_JEV_PROCESS_MAX_COST_USD=3

# =============================================================================
# Rate Limiting
# =============================================================================
MONOPELI_RATE_LIMIT_PER_MINUTE=60
MONOPELI_RATE_LIMIT_BURST=10

# =============================================================================
# Future: Redis (for scaling)
# =============================================================================
# MONOPELI_REDIS_URL=redis://redis:6379/0

# =============================================================================
# Future: Database (for persistence)
# =============================================================================
# MONOPELI_DATABASE_URL=postgresql://user:pass@db:5432/monopeli

# =============================================================================
# Frontend (Vite build-time variables)
# =============================================================================
# VITE_API_URL=http://localhost:8000
# VITE_WS_URL=ws://localhost:8000
